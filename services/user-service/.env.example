# user-service
# ------------
# Read via application.properties:
#   notification.service.url=${NOTIFICATION_SERVICE_URL:http://localhost:8000}
# The part after the ":" is only the fallback used when this env var is
# NOT set (e.g. local `docker run` without --env-file) — never rely on
# that default inside the cluster.

# Local docker run / docker-compose value (host machine, no cluster DNS yet):
NOTIFICATION_SERVICE_URL=http://localhost:8000

# In-cluster value (what your ConfigMap should actually set once deployed).
# Uncomment this and comment the line above once you're wiring the K8s
# ConfigMap — <service-name>.<namespace>.svc.cluster.local is the full
# in-cluster DNS name; you can also just use "http://notification-service:8000"
# since Services in the SAME namespace resolve by short name too.
# NOTIFICATION_SERVICE_URL=http://notification-service.mini-mesh.svc.cluster.local:8000

# Optional — only if you want to override the default port from
# application.properties (server.port=8080) without editing the jar.
# SERVER_PORT=8080
